{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "useDefineForClassFields": true,
        "types": ["vite/client", "node"],
        "paths": {
            // tsc type-checks the app against the library's *built declarations* (.d.ts), so the
            // library's intentionally non-strict source never trips the app's strict mode. Vite,
            // by contrast, bundles from src/lib via its own alias (see vite.config.ts) for
            // hot-reload. Requires `yarn build` at the repo root so dist/lib exists.
            "machine-learning": ["../dist/lib/index"]
        }
    },
    "include": ["src", "vite.config.ts"]
}
